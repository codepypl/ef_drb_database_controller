# Azure AD / Microsoft Graph
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
MAILBOX_USER=
CERT_PRIVATE_KEY_PATH=
CERT_PUBLIC_PATH=
CERT_THUMBPRINT=

# Optional Graph overrides
GRAPH_SCOPE=https://graph.microsoft.com/.default
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
TIMEZONE=Europe/Warsaw

# Application
ONEDRIVE_REGISTRY_PATH=Rejestr/ef_drb_registry.xlsx
DUPLICATE_ALERT_RECIPIENTS=alert1@example.com,alert2@example.com
VALIDATE_PERIOD=false
SCAN_INTERVAL_MINUTES=30

# Sender filter
# true  = scan mail from all senders (default)
# false = scan only addresses listed in ALLOWED_SENDERS
SCAN_ALL_SENDERS=true
ALLOWED_SENDERS=sender1@example.com,sender2@example.com
